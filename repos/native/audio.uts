/**
 * 真人音频：下载 / 存储 / 播放（仅 App-Android）
 *
 * 来源：LanguagePod101 词典音频接口（Yomichan/Anki 社区通用，真人录音）
 *   https://assets.languagepod101.com/dictionary/japanese/audiomp3.php?kanji=<表记>&kana=<读音>
 * 存储：约定式关联，应用外部私有目录 audio/<wordId>.mp3（文件管理器可见，卸载即删，不进备份）
 * 播放：MediaPlayer（短音频同步 prepare）
 * 注意：网络请求必须离开主线程（Android NetworkOnMainThreadException）
 */
// #ifdef APP-ANDROID
import File from 'java.io.File'
import FileOutputStream from 'java.io.FileOutputStream'
import InputStream from 'java.io.InputStream'
import URL from 'java.net.URL'
import HttpURLConnection from 'java.net.HttpURLConnection'
import URLEncoder from 'java.net.URLEncoder'
import MediaPlayer from 'android.media.MediaPlayer'
// #endif
import { setStoredString, getStoredString } from './storage.uts'

// 坏音频标记（LanguagePod101 对无语音的词返回 200 + 一段英文男声提示音，
// 无法按响应码识别，只能听过后手动标记）：KV bad_audio_ids = 逗号串 wordId
const BAD_AUDIO_KEY = 'bad_audio_ids'

export function isBadAudio(wordId: number): boolean {
  const raw = getStoredString(BAD_AUDIO_KEY)
  if (raw.length == 0) {
    return false
  }
  const parts = raw.split(',')
  const target = wordId.toString()
  for (let i = 0; i < parts.length; i++) {
    if (parts[i] == target) {
      return true
    }
  }
  return false
}

// 标记该词语音无效：记入 KV 并删除本地缓存（自动/手动播均跳过；后续可换备用源重新下载）
export function markBadAudio(wordId: number) {
  if (isBadAudio(wordId)) {
    return
  }
  const raw = getStoredString(BAD_AUDIO_KEY)
  setStoredString(BAD_AUDIO_KEY, raw.length == 0 ? wordId.toString() : raw + ',' + wordId.toString())
  // #ifdef APP-ANDROID
  const p = audioPath(wordId)
  if (p.length > 0) {
    const f = new File(p)
    if (f.exists()) {
      f.delete()
    }
  }
  // #endif
}

// 取消标记（重试下载用）：从 KV 移除（缓存已删，下次播放会重新下载）
export function unmarkBadAudio(wordId: number) {
  const raw = getStoredString(BAD_AUDIO_KEY)
  if (raw.length == 0) {
    return
  }
  const parts = raw.split(',')
  const target = wordId.toString()
  const kept: Array<string> = []
  for (let i = 0; i < parts.length; i++) {
    if (parts[i] != target) {
      kept.push(parts[i])
    }
  }
  setStoredString(BAD_AUDIO_KEY, kept.join(','))
}

// 音频目录（外部私有目录 /audio）
export function audioDir(): string {
  // #ifdef APP-ANDROID
  const context = UTSAndroid.getAppContext()
  if (context == null) {
    return ''
  }
  const ext = context.getExternalFilesDir(null)
  if (ext == null) {
    return ''
  }
  const dir = new File(ext.getAbsolutePath() + '/audio')
  if (!dir.exists()) {
    dir.mkdirs()
  }
  return dir.getAbsolutePath()
  // #endif
  // #ifndef APP-ANDROID
  return ''
  // #endif
}

export function audioPath(wordId: number): string {
  const dir = audioDir()
  if (dir.length == 0) {
    return ''
  }
  return dir + '/' + wordId + '.mp3'
}

export function hasAudio(wordId: number): boolean {
  // #ifdef APP-ANDROID
  const p = audioPath(wordId)
  if (p.length == 0) {
    return false
  }
  return new File(p).exists()
  // #endif
  // #ifndef APP-ANDROID
  return false
  // #endif
}

// ---- 播放 ----

// #ifdef APP-ANDROID
let player: MediaPlayer | null = null
// #endif

export function stopAudio() {
  // #ifdef APP-ANDROID
  const cur = player
  if (cur != null) {
    try {
      if (cur.isPlaying()) {
        cur.stop()
      }
      cur.release()
    } catch (e) {
      // 忽略释放异常
    }
    player = null
  }
  // #endif
}

// 播放本地音频（无文件返回 false）
export function playAudio(wordId: number): boolean {
  // #ifdef APP-ANDROID
  const p = audioPath(wordId)
  if (p.length == 0 || !new File(p).exists()) {
    return false
  }
  stopAudio()
  try {
    const mp = new MediaPlayer()
    mp.setDataSource(p)
    mp.prepare()
    mp.start()
    player = mp
    return true
  } catch (e) {
    console.error('音频播放失败', e)
    return false
  }
  // #endif
  // #ifndef APP-ANDROID
  return false
  // #endif
}

// ---- 下载 ----

// 坏音频指纹：LanguagePod101 对无语音的词返回 HTTP 200 + 一段固定的英文男声提示音
// （2026-09-02 实测：任意假词响应恒为 52288 字节且内容相同；真词录音 2~30KB）
// 下载后按大小校验，命中即删缓存，由上层在主线程自动标记该词
const BAD_AUDIO_SIZE = 52288

// #ifdef APP-ANDROID
// 阻塞式下载（须在 io 线程调用）：'ok'=成功 'bad'=坏音频指纹（已删缓存） 'fail'=网络/服务失败
function downloadBlocking(wordId: number, term: string, reading: string): string {
  try {
    const kanji = URLEncoder.encode(term, 'UTF-8')
    const kana = reading.length > 0 ? URLEncoder.encode(reading, 'UTF-8') : kanji
    const url = new URL('https://assets.languagepod101.com/dictionary/japanese/audiomp3.php?kanji=' + kanji + '&kana=' + kana)
    const conn = url.openConnection() as HttpURLConnection
    conn.setConnectTimeout(10000)
    conn.setReadTimeout(15000)
    const code = conn.getResponseCode()
    if (code != 200) {
      conn.disconnect()
      return 'fail'
    }
    const type = conn.getContentType()
    if (type.indexOf('audio') < 0) {
      // 非音频响应（如错误页）
      conn.disconnect()
      return 'fail'
    }
    const input: InputStream = conn.getInputStream()
    const output = new FileOutputStream(new File(audioPath(wordId)))
    const buf = new ByteArray(8192)
    let len = input.read(buf)
    while (len > 0) {
      output.write(buf, 0, len)
      len = input.read(buf)
    }
    output.flush()
    output.close()
    input.close()
    conn.disconnect()
    // 坏音频指纹校验：提示音文件恒定大小，命中即删（上层主线程自动标记）
    const f = new File(audioPath(wordId))
    if (f.length() == BAD_AUDIO_SIZE) {
      f.delete()
      return 'bad'
    }
    return 'ok'
  } catch (e) {
    console.error('音频下载失败 wordId=' + wordId, e)
    return 'fail'
  }
}
// #endif

// 异步下载（io 线程执行，主线程回调 resolve）：'ok' / 'bad'（坏音频，已删缓存待标记）/ 'fail'
export function downloadAudioAsync(wordId: number, term: string, reading: string): Promise<string> {
  return new Promise<string>((resolve, _reject) => {
    // #ifdef APP-ANDROID
    UTSAndroid.getDispatcher('io').async(function (_: any | null) {
      const r = downloadBlocking(wordId, term, reading)
      UTSAndroid.getDispatcher('main').async(function (_2: any | null) {
        resolve(r)
      }, null)
    }, null)
    // #endif
    // #ifndef APP-ANDROID
    resolve('fail')
    // #endif
  })
}
