/**
 * 调度器（纯函数，无 IO）
 *
 * 固定周期表为主 + 熟练度微调：
 *   实际间隔（天） = cycle[stage] × 熟练度系数(0.8~1.2) × 评分附加系数
 *
 * 三档评分（忘记/模糊/记得，2026-08-28 由四档简化，简单档预留未用）：
 *   记得→stage+1；模糊→不升、间隔×0.7；忘记→stage−1（clamp 至 0）、间隔×0.5
 *   会话层规则：模糊/忘记的词放回队尾，需连续两次「记得」才通过（studySession 实现）
 */
import { RATING_AGAIN, RATING_HARD, RATING_GOOD, RATING_EASY, WORD_STATUS_LEARNING, WORD_STATUS_REVIEWING, WORD_STATUS_MASTERED, PRIORITY_EASY, PRIORITY_MID } from './types.uts'

const DAY_MS: number = 86400000
// 熟练度达标阈值：3档到周期顶且熟练度 >= 该值 → mastered
const MASTERED_FAMILIARITY: number = 80
// 2档熟练度达标阈值（首考记得 40 + 复习记得 +20 = 60，即两次记得）
const MASTERED_FAMILIARITY_MID: number = 60

// 档位归一：越界值按 3 档处理
function normPriority(priority: number): number {
  if (priority == PRIORITY_EASY || priority == PRIORITY_MID) {
    return priority
  }
  return 3
}

/**
 * 掌握判定（按档位放宽）：
 * - 1档：任意一次「记得」即掌握（首考也算）
 * - 2档：两次「记得」即掌握（熟练度累计 60，忘了会扣熟练度自然延后）
 * - 3档：stage 到周期顶 && 熟练度 >= 80（原有行为）
 */
function masteryReached(priority: number, stage: number, familiarity: number, cycle: Array<number>, rating: number): boolean {
  if (rating < RATING_GOOD) {
    return false
  }
  const p = normPriority(priority)
  if (p == PRIORITY_EASY) {
    return true
  }
  if (p == PRIORITY_MID) {
    return familiarity >= MASTERED_FAMILIARITY_MID && stage >= 1
  }
  return stage >= cycle.length - 1 && familiarity >= MASTERED_FAMILIARITY
}

export type SchedState = {
  status: string,
  stage: number,
  familiarity: number,
  dueDate: number,
  streak: number,
  lapses: number
}

// 默认周期阶梯（天），可被 plan.cycleJson 覆盖
export const DEFAULT_CYCLE: Array<number> = [1, 2, 4]

function clamp(v: number, min: number, max: number): number {
  if (v < min) return min
  if (v > max) return max
  return v
}

// 熟练度系数：0(0.8) ~ 100(1.2)
function familiarityFactor(f: number): number {
  return 0.8 + f / 250
}

// 计算某档位的实际间隔（天）
function intervalOf(cycle: Array<number>, stage: number, familiarity: number, extra: number): number {
  const s = clamp(stage, 0, cycle.length - 1)
  return cycle[s] * familiarityFactor(familiarity) * extra
}

/**
 * 首考评分 → 初始化学习状态
 * now：当前毫秒时间戳；priority：档位（1档首考记得即掌握）
 */
export function applyFirstRating(rating: number, cycle: Array<number>, now: number, priority: number): SchedState {
  let stage = 0
  let familiarity = 0
  let extra = 1.0
  if (rating == RATING_GOOD) {
    stage = 1
    familiarity = 40
  } else if (rating == RATING_EASY) {
    stage = 2
    familiarity = 50
  } else if (rating == RATING_HARD) {
    stage = 0
    familiarity = 20
    extra = 0.7
  } else {
    // RATING_AGAIN：会话层连对两次记得才通过，此处按最严重失败档记账
    stage = 0
    familiarity = 0
    extra = 0.5
  }
  const days = intervalOf(cycle, stage, familiarity, extra)
  const s: SchedState = {
    status: masteryReached(priority, stage, familiarity, cycle, rating) ? WORD_STATUS_MASTERED : WORD_STATUS_LEARNING,
    stage: stage,
    familiarity: familiarity,
    dueDate: now + days * DAY_MS,
    streak: rating == RATING_AGAIN ? 0 : 1,
    lapses: rating == RATING_AGAIN ? 1 : 0
  }
  return s
}

/**
 * 复习评分 → 更新学习状态（纯函数：返回新状态，不改入参）
 * priority：档位（1/2 档掌握门槛放宽，见 masteryReached）
 */
export function applyReviewRating(rating: number, prev: SchedState, cycle: Array<number>, now: number, priority: number): SchedState {
  let stage = prev.stage
  let familiarity = prev.familiarity
  let extra = 1.0
  let streak = prev.streak
  let lapses = prev.lapses

  if (rating == RATING_AGAIN) {
    // 忘记：降一档（stage 0 时保持 0，clamp 兜底）
    stage = prev.stage - 1
    familiarity = familiarity - 30
    streak = 0
    lapses = lapses + 1
    extra = 0.5
  } else if (rating == RATING_HARD) {
    // 档位不动，间隔 ×0.7 短期重排
    familiarity = familiarity - 10
    extra = 0.7
    streak = streak + 1
  } else if (rating == RATING_GOOD) {
    stage = stage + 1
    familiarity = familiarity + 20
    streak = streak + 1
  } else {
    // RATING_EASY：跳档加速
    stage = stage + 2
    familiarity = familiarity + 10
    extra = 1.3
    streak = streak + 1
  }

  stage = clamp(stage, 0, cycle.length - 1)
  familiarity = clamp(familiarity, 0, 100)

  const days = intervalOf(cycle, stage, familiarity, extra)
  let status = WORD_STATUS_REVIEWING
  if (masteryReached(priority, stage, familiarity, cycle, rating)) {
    status = WORD_STATUS_MASTERED
  }

  const s: SchedState = {
    status: status,
    stage: stage,
    familiarity: familiarity,
    dueDate: now + days * DAY_MS,
    streak: streak,
    lapses: lapses
  }
  return s
}
