<template>
  <view class="page">
    <image class="aurora-bg study-wash" src="/static/aurora-bg.png" mode="aspectFill"></image>
    <view class="save-notice" v-if="saveFailed">
      <text class="save-notice-text">本词保存失败，进度草稿已保留。请重试保存后继续。</text>
      <view class="save-retry pressable-soft" hover-class="press-soft" @click="saveProgress"><text class="save-notice-text">{{ saving ? '正在保存…' : '重试保存' }}</text></view>
    </view>
    <!-- 顶部：模式胶囊 + 计数 + 喇叭 -->
    <view class="top" v-if="!finished">
      <view class="mode-chip" :class="modeChipClass()">
        <text class="mode-chip-text">{{ modeText }}</text>
      </view>
      <text class="count">{{ index + 1 }} / {{ total }}</text>
      <view class="speaker pressable-soft" hover-class="press-soft" @click="playCurrent"><text class="speaker-text">发音</text></view>
    </view>
    <!-- 线性进度 -->
    <view class="track" v-if="!finished">
      <view class="track-fill" :style="'width:' + progressPct() + '%'"></view>
    </view>

    <!-- 词卡：点击进入详情页，评分按钮悬浮在详情页底部 -->
    <view class="card pressable-soft" hover-class="press-soft" @click="goDetail" v-if="!finished">
      <view class="card-head">
        <text class="card-kicker">WORD NOTES</text>
        <view class="prio-pill" :class="prioClass()">
          <text class="prio-pill-text" :class="prioTextClass()">{{ priorityLabel() }}</text>
        </view>
      </view>
      <view class="word-face">
        <text class="term">{{ term }}</text>
        <view class="accent-pill" v-if="accentText != ''">
          <text class="accent-pill-text">{{ accentText }}</text>
        </view>
      </view>
      <view class="card-foot">
        <text class="card-hint">{{ saving ? '正在保存本词进度…' : '轻触词卡，查看释义并评分' }}</text>
        <text class="card-foot-mark">→</text>
      </view>
    </view>

    <!-- 会话结束 -->
    <view class="done" v-if="finished && !empty">
      <view class="done-badge">
        <text class="done-badge-icon">✓</text>
      </view>
      <text class="done-title">本场完成</text>
      <text class="done-text">{{ saved ? '每个完成词的学习记录均已保存' : '正在保存学习记录…' }}</text>
      <view class="done-btn pressable-soft" hover-class="press-soft" @click="goBack">
        <text class="done-btn-text">返回</text>
      </view>
    </view>

    <!-- 空会话 -->
    <view class="done" v-if="empty">
      <view class="done-badge done-badge-dim">
        <text class="done-badge-icon">休</text>
      </view>
      <text class="done-title">暂无任务</text>
      <text class="done-text">{{ modeText }}队列为空</text>
      <view class="done-btn pressable-soft" hover-class="press-soft" @click="goBack">
        <text class="done-btn-text">返回</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { Word } from '../../domain/types.uts'
  import { accentsDisplay } from '../../domain/format.uts'
  import { manualPlay, prefetchAudioForWord } from '../../services/audio.uts'
  import { SessionState, MODE_NEW, MODE_REVIEW, createSession, answer, answerMastered, snapshotDraft, hasDraft, restoreDraft, clearDraft, commitSession, consumeDetailRating, consumeDetailMastered } from '../../services/studySession.uts'
  import { buildReviewQueue, pickNewWordQueue } from '../../services/today.uts'
  import { getPlanRepo } from '../../repos/sqlite/planRepoImpl.uts'
  import { awaitDatabase } from '../../repos/sqlite/bootstrap.uts'

  let session: SessionState | null = null
  let studyMode = MODE_REVIEW
  let currentWord: Word | null = null
  let prioMap: Map<number, number> | null = null

  const finished = ref(false)
  const empty = ref(false)
  const saved = ref(false)
  const saving = ref(false)
  const saveFailed = ref(false)
  const index = ref(0)
  const total = ref(0)
  const modeText = ref('复习')
  const term = ref('')
  const accentText = ref('')
  const currentPriority = ref(3)

  // 会话进度百分比（模板只能调本地函数）
  const progressPct = (): number => {
    if (total.value == 0) {
      return 0
    }
    return index.value * 100 / total.value
  }

  // 档位徽章（1 一次即会 / 2 两次即会 / 3 常规）
  const priorityLabel = (): string => {
    if (currentPriority.value == 1) {
      return '① 一次即会'
    }
    if (currentPriority.value == 2) {
      return '② 两次即会'
    }
    return '③ 常规'
  }

  // 模式胶囊配色：复习=红 / 学新词=黄
  const modeChipClass = (): string => {
    return modeText.value == '学新词' ? 'chip-new' : 'chip-review'
  }

  const prioClass = (): string => {
    if (currentPriority.value == 1) {
      return 'prio-1'
    }
    if (currentPriority.value == 2) {
      return 'prio-2'
    }
    return 'prio-3'
  }

  const prioTextClass = (): string => {
    if (currentPriority.value == 1) {
      return 'prio-text-1'
    }
    if (currentPriority.value == 2) {
      return 'prio-text-2'
    }
    return 'prio-text-3'
  }

  // 当前词上屏（A 面含音调展示 + 档位徽章；朗读改到进入词卡详情页时触发）
  const showCurrent = (s: SessionState) => {
    if (s.index >= s.queue.length) {
      return
    }
    const w = s.queue[s.index]
    currentWord = w
    term.value = w.term
    accentText.value = accentsDisplay(w.accent)
    const m = prioMap
    let p = 3
    if (m != null) {
      const v = m.get(w.id)
      if (v != null) {
        p = v
      }
    }
    currentPriority.value = p
    // 出词静默预下载语音（不播）：点进词卡详情页时大概率已有缓存可直接自动播
    prefetchAudioForWord(w)
  }

  // 手动喇叭：当前词（无缓存时先下载再播）
  const playCurrent = async () => {
    const w = currentWord
    if (w == null) {
      return
    }
    const ok = await manualPlay(w)
    if (!ok) {
      uni.showToast({ title: '暂无音频（下载失败或无网络）', icon: 'none' })
    }
  }

  const syncRefs = (s: SessionState) => {
    index.value = s.index
    total.value = s.queue.length
    finished.value = s.finished
    showCurrent(s)
  }

  // 每题先存草稿；通过的词写库成功后再展示下一题，失败时保留原题并提供重试。
  const saveProgress = async () => {
    const cur = session
    if (cur == null || saving.value) {
      return
    }
    saving.value = true
    saveFailed.value = false
    try {
      snapshotDraft(cur)
      const ok = await commitSession(cur)
      if (!ok) {
        saveFailed.value = true
        uni.showToast({ title: '本词保存失败，请重试', icon: 'none' })
        return
      }
      saved.value = cur.finished
      syncRefs(cur)
    } catch (e) {
      saveFailed.value = true
      console.error('本词进度保存失败', e)
      uni.showToast({ title: '本词保存失败，请重试', icon: 'none' })
    } finally {
      saving.value = false
    }
  }

  // 新会话：按模式取真实队列。
  const startFresh = async (mode: string) => {
    const plan = await getPlanRepo().getActivePlan()
    let queue: Array<Word> = [] as Array<Word>
    if (mode == MODE_NEW) {
      // 每批 dailyNew 个，完成词即时落库后，下一批自动跳过它们。
      queue = await pickNewWordQueue()
    } else {
      const cap = plan == null ? 200 : plan.dailyReviewCap
      const items = await buildReviewQueue(cap)
      for (let i = 0; i < items.length; i++) {
        queue.push(items[i].word)
      }
    }
    clearDraft()
    if (queue.length == 0) {
      empty.value = true
      finished.value = true
      return
    }
    const s = createSession(mode, queue, plan == null ? -1 : plan.id)
    session = s
    snapshotDraft(s)
    syncRefs(s)
  }

  // 草稿恢复
  const startWithDraft = async (mode: string) => {
    const d = await restoreDraft(mode)
    if (d == null) {
      await startFresh(mode)
      return
    }
    session = d
    // 旧草稿或上次在事务/快照之间退出：先补存已完成词，再恢复剩余题目。
    await saveProgress()
  }

  // 入口：加载档位映射，有草稿先询问
  const start = async (mode: string) => {
    const ready = await awaitDatabase()
    if (!ready) {
      uni.showToast({ title: '本地数据库尚未就绪', icon: 'none' })
      return
    }
    try {
      prioMap = await getPlanRepo().listWordPriorities()
    } catch (e) {
      prioMap = null
    }
    if (hasDraft(mode)) {
      uni.showModal({
        title: '恢复会话',
        content: '检测到未完成的本场会话，是否继续？',
        confirmText: '继续',
        cancelText: '重新开始',
        success: (res) => {
          if (res.confirm) {
            startWithDraft(mode)
          } else {
            startFresh(mode)
          }
        },
        fail: (_e) => {
          startFresh(mode)
        }
      })
    } else {
      startFresh(mode)
    }
  }

  const rate = (rating: number) => {
    const cur = session
    if (cur == null || cur.finished || saving.value || saveFailed.value) {
      return
    }
    const s = answer(cur, rating, Date.now())
    session = s
    saveProgress()
  }

  // 「已掌握」快捷入口：当前词直接通过出列（1/2 档词，详情页底部按钮触发）
  const mastered = () => {
    const cur = session
    if (cur == null || cur.finished || saving.value || saveFailed.value) {
      return
    }
    const s = answerMastered(cur, Date.now())
    session = s
    saveProgress()
  }

  const goDetail = () => {
    const w = currentWord
    if (w == null || saving.value || saveFailed.value) {
      return
    }
    // rate=1：详情页底部显示三档评分
    uni.navigateTo({ url: '/pages/word/detail?id=' + w.id + '&rate=1' })
  }

  const goBack = () => {
    uni.navigateBack()
  }

  onLoad((options) => {
    const mode = options == null ? MODE_REVIEW : (options['mode'] == MODE_NEW ? MODE_NEW : MODE_REVIEW)
    studyMode = mode
    modeText.value = mode == MODE_NEW ? '学新词' : '复习'
    start(mode)
  })

  onBackPress(() => {
    if (saving.value) {
      uni.showToast({ title: '正在保存本词，请稍候', icon: 'none' })
      return true
    }
    return false
  })

  // 从详情页返回：消费详情页底部提交的评分/「已掌握」，出下一词
  onShow(() => {
    const m = consumeDetailMastered()
    if (m && !finished.value) {
      mastered()
      return
    }
    const r = consumeDetailRating()
    if (r >= 0 && !finished.value) {
      rate(r)
    }
  })
</script>

<style lang="scss">
  @import '../../uni.scss';

  /* 半透明手札延续首页与详情；无外扩投影，避免原生触控边界重叠。 */

  .page {
    flex: 1;
    padding: 24rpx 28rpx 32rpx;
    background-color: $n-bg;
  }
  .study-wash { opacity: 0.58; }
  .save-notice { padding: 24rpx; margin-bottom: 20rpx; border-radius: 22rpx; background-color: #f8e4dc; }
  .save-notice-text { font-size: 26rpx; line-height: 40rpx; color: $a-red-ink; }
  .save-retry { align-items: center; padding: 16rpx; margin-top: 12rpx; border-radius: 18rpx; background-color: $n-card; }

  /* ---------- 顶部 ---------- */
  .top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18rpx;
  }
  .mode-chip {
    border: 1rpx solid rgba(255, 255, 255, 0.88);
    border-radius: 999rpx;
    padding: 14rpx 24rpx;
  }
  .chip-review {
    background-color: rgba(243, 184, 164, 0.62);
  }
  .chip-new {
    background-color: rgba(247, 223, 163, 0.68);
  }
  .mode-chip-text {
    font-size: 24rpx;
    line-height: 36rpx;
    color: $n-ink;
    font-family: monospace;
    letter-spacing: 1rpx;
  }
  .count {
    flex: 1;
    font-size: 28rpx;
    font-family: monospace;
    letter-spacing: 2rpx;
    color: $n-ink;
    text-align: center;
  }
  .speaker {
    min-width: 44px;
    min-height: 44px;
    padding: 16rpx 22rpx;
    border-radius: 999rpx;
    background-color: rgba(255, 253, 249, 0.68);
    border: 1rpx solid rgba(255, 255, 255, 0.9);
    align-items: center;
    justify-content: center;
  }
  .speaker-text { font-size: 26rpx; color: $n-ink; }
  .track {
    height: 8rpx;
    border-radius: 999rpx;
    background-color: rgba(255, 253, 249, 0.76);
    border-width: 0rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
  }
  .track-fill {
    height: 8rpx;
    border-radius: 999rpx;
    background-color: #a4b9c9;
  }

  /* ---------- 一张手札：微标签 / 题面 / 轻触提示 ---------- */
  .card {
    flex: 1;
    padding: 32rpx;
    background-color: rgba(255, 253, 249, 0.76);
    border: 1rpx solid rgba(255, 255, 255, 0.9);
    border-radius: 38rpx;
  }
  .card-head { flex-direction: row; align-items: center; justify-content: space-between; }
  .card-kicker { font-size: 20rpx; font-family: monospace; letter-spacing: 3rpx; color: $a-red-ink; }
  .word-face { flex: 1; align-items: center; justify-content: center; padding: 28rpx 0; }
  .term {
    width: 100%;
    font-size: 80rpx;
    line-height: 108rpx;
    text-align: center;
    font-family: serif;
    font-weight: 500;
    color: $n-ink;
  }
  .prio-pill {
    border: 1rpx solid rgba(255, 255, 255, 0.84);
    border-radius: 999rpx;
    padding: 10rpx 18rpx;
    margin-left: 16rpx;
  }
  .prio-1 {
    background-color: rgba(217, 233, 215, 0.76);
  }
  .prio-2 {
    background-color: rgba(247, 223, 163, 0.66);
  }
  .prio-3 {
    background-color: rgba(238, 231, 218, 0.72);
  }
  .prio-pill-text {
    font-size: 22rpx;
    line-height: 32rpx;
    color: $n-ink;
    font-family: monospace;
    letter-spacing: 1rpx;
  }
  .prio-text-1 {
    color: $n-ink;
  }
  .prio-text-2 {
    color: $n-ink;
  }
  .prio-text-3 {
    color: $n-ink;
  }
  .accent-pill {
    background-color: rgba(255, 246, 232, 0.68);
    border: 1rpx solid rgba(255, 255, 255, 0.84);
    border-radius: 999rpx;
    padding: 10rpx 28rpx;
    margin-top: 28rpx;
  }
  .accent-pill-text {
    font-size: 28rpx;
    line-height: 42rpx;
    color: $a-red-ink;
    font-family: serif;
    font-weight: 500;
  }
  .card-foot { flex-direction: row; align-items: center; border-top: 1rpx solid rgba(95, 89, 101, 0.12); padding-top: 24rpx; }
  .card-hint { flex: 1; font-size: 24rpx; line-height: 38rpx; color: $n-text2; }
  .card-foot-mark { font-size: 32rpx; color: $a-red-ink; margin-left: 16rpx; }

  /* ---------- 结束/空会话 ---------- */
  .done {
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: 32rpx;
    background-color: rgba(255, 253, 249, 0.76);
    border: 1rpx solid rgba(255, 255, 255, 0.9);
    border-radius: 38rpx;
  }
  .done-badge {
    width: 128rpx;
    height: 128rpx;
    border-radius: 32rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.88);
    background-color: rgba(217, 233, 215, 0.76);
    align-items: center;
    justify-content: center;
  }
  .done-badge-dim {
    background-color: rgba(238, 231, 218, 0.72);
  }
  .done-badge-icon {
    font-size: 56rpx;
    font-family: serif;
    color: $n-ink;
  }
  .done-title {
    font-size: $c-fs-xl;
    font-family: serif;
    font-weight: 500;
    color: $n-ink;
    margin-top: 32rpx;
  }
  .done-text {
    font-size: 26rpx;
    line-height: 40rpx;
    text-align: center;
    color: $n-text2;
    margin-top: 12rpx;
    letter-spacing: 1rpx;
  }
  .done-btn {
    margin-top: 64rpx;
    min-height: 48px;
    background-color: rgba(247, 223, 163, 0.72);
    border: 1rpx solid rgba(255, 255, 255, 0.9);
    border-radius: 24rpx;
    padding: 24rpx 88rpx;
    align-items: center;
    justify-content: center;
  }
  .done-btn-text {
    color: $n-ink;
    font-size: 28rpx;
  }
</style>
