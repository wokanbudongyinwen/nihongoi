<template>
  <view class="page">
    <image class="aurora-bg" src="/static/aurora-bg.png" mode="aspectFill"></image>

    <scroll-view class="list" scroll-y="true" show-scrollbar="false">
      <view class="neo-card-sm word-row pressable-soft" hover-class="press-soft" v-for="(w, i) in words" :key="w.id" @click="goDetail(w)">
        <text class="row-no">{{ i + 1 }}</text>
        <view class="word-main">
          <view class="word-line">
            <text class="word-term" :class="i == words.length - 1 ? 'term-on' : ''">{{ w.term }}</text>
            <text class="word-reading">{{ w.reading }}</text>
            <text class="cur-tag" v-if="i == words.length - 1">当前主词</text>
          </view>
          <text class="word-meaning">{{ w.meaning }}</text>
        </view>
        <text class="word-pos">{{ w.pos }}</text>
      </view>
      <text class="list-end" v-if="words.length > 0">— 共 {{ words.length }} 词 · 按链顺序（旧 → 新）—</text>
      <view class="empty" v-if="loaded && words.length == 0">
        <text class="empty-text">链条为空</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
  import { Word } from '../../domain/types.uts'
  import { getWordRepo } from '../../repos/sqlite/wordRepoImpl.uts'

  // 链条单词列表：URL 参数 ids = 逗号分隔的 wordId 序列（旧 → 新，最后一个为当前主词）
  const words = ref<Array<Word>>([])
  const loaded = ref(false)

  const goDetail = (w: Word) => {
    uni.navigateTo({ url: '/pages/word/detail?id=' + w.id })
  }

  onLoad((options) => {
    let ids = ''
    if (options != null) {
      const v = options['ids']
      if (v != null) {
        ids = v
      }
    }
    const parts = ids.split(',')
    const repo = getWordRepo()
    const load = async () => {
      const list: Array<Word> = []
      for (let i = 0; i < parts.length; i++) {
        const id = parseInt(parts[i])
        if (isNaN(id) || id <= 0) {
          continue
        }
        try {
          const w = await repo.getById(id)
          if (w != null) {
            list.push(w)
          }
        } catch (e) {
          console.error('链条词条读取失败', id, e)
        }
      }
      words.value = list
      loaded.value = true
    }
    load()
  })
</script>

<style lang="scss">
  @import '../../uni.scss';

  .page {
    flex: 1;
    padding: 24rpx 28rpx 0;
    background-color: $n-bg;
    background-image: linear-gradient(180deg, #e9e3f1 0%, #f8f4ed 34%, #edf2f4 100%);
  }
  .list {
    flex: 1;
    padding: 4rpx 2rpx 40rpx;
  }
  .word-row {
    padding: 24rpx;
    margin: 0 4rpx 18rpx 0;
    flex-direction: row;
    align-items: center;
  }
  .row-no {
    width: 56rpx;
    font-size: 22rpx;
    color: $n-text3;
    font-family: monospace;
  }
  .word-main {
    flex: 1;
  }
  .word-line {
    flex-direction: row;
    align-items: center;
  }
  .word-term {
    font-size: 32rpx;
    font-family: serif;
    font-weight: 500;
    color: $n-ink;
  }
  .term-on {
    color: $a-purple-ink;
    font-weight: bold;
  }
  .word-reading {
    font-size: 24rpx;
    color: $a-blue-ink;
    font-weight: bold;
    margin-left: 16rpx;
  }
  .cur-tag {
    font-size: 18rpx;
    color: $n-ink;
    background-color: $n-purple;
    border-radius: 999rpx;
    padding: 2rpx 12rpx;
    margin-left: 12rpx;
  }
  .word-meaning {
    font-size: 26rpx;
    color: $n-text2;
    margin-top: 8rpx;
  }
  .word-pos {
    font-size: 22rpx;
    color: $n-ink;
    background-color: $n-cream;
    border-width: 1rpx;
    border-style: solid;
    border-color: $a-line;
    border-radius: 999rpx;
    padding: 4rpx 12rpx;
    margin-left: 16rpx;
  }
  .list-end {
    font-size: 24rpx;
    color: $n-text3;
    text-align: center;
    padding: 24rpx 0;
  }
  .empty {
    padding: 80rpx 0;
    align-items: center;
  }
  .empty-text {
    font-size: 26rpx;
    color: $n-text3;
  }
</style>
