<template>
  <view class="page">
    <image class="aurora-bg" src="/static/aurora-bg.png" mode="aspectFill"></image>
    <!-- 头部：以留白和排版建立编辑感，不再套用大卡片 -->
    <view class="hero">
      <view class="hero-top">
        <text class="hero-date">{{ todayText() }}</text>
        <view class="plan-chip" v-if="planName != ''">
          <text class="plan-chip-text">{{ planName }}</text>
        </view>
      </view>
      <text class="hero-kicker">TODAY'S STUDY</text>
      <text class="hero-hello">{{ helloText() }}</text>
      <text class="hero-note">一点一点，让今天的词留下来。</text>
    </view>

    <view class="section-heading">
      <text class="section-kicker">TODAY</text>
      <text class="section-title">今日任务</text>
    </view>

    <!-- 今日主任务：采用不对称编辑网格，突出优先复习 -->
    <view class="entries">
      <view class="neo-card entry entry-review pressable" hover-class="press" @click="goStudy('review')">
        <text class="entry-kicker">REVIEW</text>
        <text class="entry-title">复习</text>
        <text class="entry-num">{{ dueCount }}</text>
        <text class="entry-unit">个到期</text>
      </view>
      <view class="neo-card entry entry-new pressable" hover-class="press" @click="goStudy('new')">
        <text class="entry-kicker">NEW WORDS</text>
        <text class="entry-title">学新词</text>
        <text class="entry-num">{{ todayNewCount }}</text>
        <text class="entry-unit">今日已学</text>
      </view>
    </view>

    <!-- 进度与统计合并为一张信息面板，减少卡片堆叠 -->
    <view class="neo-card panel overview" v-if="planName != ''">
      <view class="overview-head">
        <text class="overview-label">LEARNING PROGRESS</text>
        <text class="overview-total">{{ learnedCount }} / {{ totalCount }}</text>
      </view>
      <view class="bar" v-if="totalCount > 0">
        <view class="bar-ok" :style="'width:' + masterPct() + '%'"></view>
        <view class="bar-learning" :style="'width:' + learningPct() + '%'"></view>
        <view class="bar-rest"></view>
      </view>
      <view class="legend" v-if="totalCount > 0">
        <view class="legend-item">
          <view class="dot dot-ok"></view>
          <text class="legend-text">掌握 {{ masteredCount }}</text>
        </view>
        <view class="legend-item">
          <view class="dot dot-learning"></view>
          <text class="legend-text">学习 {{ learningCount }}</text>
        </view>
        <view class="legend-item legend-last">
          <view class="dot dot-rest"></view>
          <text class="legend-text">未学 {{ restCount() }}</text>
        </view>
      </view>
      <view class="overview-line"></view>
      <view class="stats-row">
        <view class="stat pressable-soft" hover-class="press-soft" @click="goStats('learning')">
          <text class="stat-num num-blue">{{ learningCount }}</text>
          <text class="stat-label">在学</text>
        </view>
        <view class="stat pressable-soft" hover-class="press-soft" @click="goStats('learned')">
          <text class="stat-num num-green">{{ learnedCount }}</text>
          <text class="stat-label">已学</text>
        </view>
        <view class="stat pressable-soft" hover-class="press-soft" @click="goStats('todayReview')">
          <text class="stat-num num-red">{{ todayReviewCount }}</text>
          <text class="stat-label">今日复习</text>
        </view>
        <view class="stat pressable-soft" hover-class="press-soft" @click="goStats('all')">
          <text class="stat-num">{{ totalCount }}</text>
          <text class="stat-label">总词数</text>
        </view>
      </view>
    </view>

    <view class="section-heading tools-heading">
      <text class="section-kicker">EXPLORE</text>
      <text class="section-title">学习工具</text>
    </view>

    <!-- 文字目录式导航：编号承担识别，不使用不统一的伪图标 -->
    <view class="nav-row">
      <view class="nav nav-purple pressable" hover-class="press" @click="go('/pages/word/chain')">
        <text class="nav-index">01</text>
        <text class="nav-text">链式记忆</text>
        <text class="nav-desc">建立关联</text>
      </view>
      <view class="nav nav-blue pressable" hover-class="press" @click="go('/pages/plan/list')">
        <text class="nav-index">02</text>
        <text class="nav-text">计划</text>
        <text class="nav-desc">学习节奏</text>
      </view>
      <view class="nav nav-green pressable" hover-class="press" @click="go('/pages/library/library')">
        <text class="nav-index">03</text>
        <text class="nav-text">词库</text>
        <text class="nav-desc">浏览检索</text>
      </view>
      <view class="nav nav-neutral nav-right pressable" hover-class="press" @click="go('/pages/settings/settings')">
        <text class="nav-index">04</text>
        <text class="nav-text">设置</text>
        <text class="nav-desc">周期备份</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { buildTodaySummary } from '../../services/today.uts'
  import { awaitDatabase } from '../../repos/sqlite/bootstrap.uts'

  const planName = ref('')
  const dueCount = ref(0)
  const learningCount = ref(0)
  const learnedCount = ref(0)
  const masteredCount = ref(0)
  const totalCount = ref(0)
  const todayNewCount = ref(0)
  const todayReviewCount = ref(0)

  // ---------- 展示辅助（模板只能调本地函数） ----------

  const WEEKS: Array<string> = ['日', '一', '二', '三', '四', '五', '六']

  const todayText = (): string => {
    const d = new Date()
    const week = WEEKS[d.getDay()]
    return (d.getMonth() + 1) + '月' + d.getDate() + '日 · 周' + week
  }

  const helloText = (): string => {
    const h = new Date().getHours()
    if (h < 6) {
      return '夜深了，注意休息'
    }
    if (h < 11) {
      return '早上好，开始今天的学习吧'
    }
    if (h < 14) {
      return '中午好，抽空背几个词'
    }
    if (h < 18) {
      return '下午好，继续加油'
    }
    return '晚上好，温故而知新'
  }

  const restCount = (): number => {
    const rest = totalCount.value - learnedCount.value
    return rest > 0 ? rest : 0
  }

  const masterPct = (): number => {
    if (totalCount.value == 0) {
      return 0
    }
    return masteredCount.value * 100 / totalCount.value
  }

  const learningPct = (): number => {
    if (totalCount.value == 0) {
      return 0
    }
    return learningCount.value * 100 / totalCount.value
  }

  // ---------- 数据 ----------

  const load = async () => {
    try {
      // 冷启动期先等数据库初始化完成（onLaunch 的 initDatabase 是异步的）
      const ok = await awaitDatabase()
      if (!ok) {
        return
      }
      const s = await buildTodaySummary()
      planName.value = s.planName
      dueCount.value = s.dueCount
      learningCount.value = s.learningCount
      learnedCount.value = s.learnedCount
      masteredCount.value = s.masteredCount
      totalCount.value = s.totalCount
      todayNewCount.value = s.todayNewCount
      todayReviewCount.value = s.todayReviewCount
    } catch (e) {
      console.error('今日任务加载失败', e)
    }
  }

  onLoad(() => {
    load()
  })

  // 从背词会话返回后刷新统计
  onShow(() => {
    load()
  })

  const goStudy = (mode: string) => {
    uni.navigateTo({ url: '/pages/study/study?mode=' + mode })
  }
  const go = (url: string) => {
    uni.navigateTo({ url: url })
  }
  // 统计条下钻：learning 在学 / learned 已学 / todayReview 今日复习 / all 计划全部
  const goStats = (type: string) => {
    uni.navigateTo({ url: '/pages/index/stats?type=' + type })
  }
</script>

<style lang="scss">
