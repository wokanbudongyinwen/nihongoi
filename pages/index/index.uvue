<template>
  <view class="page">
    <view :style="'height:' + safeTop + 'px'"></view>
    <swiper class="home-swiper" :current="currentPage" :autoplay="false" :circular="false"
      :indicator-dots="false" @change="onPageChange">
      <swiper-item>
        <view class="sheet-shell">
          <view class="sheet">
            <image class="sheet-wash" src="/static/aurora-bg.png" mode="aspectFill"></image>
            <scroll-view class="sheet-scroll" :scroll-y="true" :show-scrollbar="false">
              <view class="sheet-content">
                <view class="folio">
                  <text class="folio-label">NIHONGO / DAILY</text>
                  <text class="folio-date">{{ todayText() }}</text>
                </view>
                <view class="hero">
                  <text class="eyebrow">TODAY'S STUDY</text>
                  <text class="hero-title">{{ helloText() }}</text>
                  <text class="hero-note">一点一点，让今天的词留下来。</text>
                  <view class="plan-line" v-if="planName != ''">
                    <text class="plan-label">正在学习</text>
                    <text class="plan-name">{{ planName }}</text>
                  </view>
                </view>

                <view class="section-heading">
                  <text class="section-title">今日任务</text>
                  <text class="section-meta">01 / PRACTICE</text>
                </view>
                <view class="entries">
                  <view class="entry entry-review pressable-soft" hover-class="press-soft" @click="goStudy('review')">
                    <text class="entry-kicker">REVIEW</text>
                    <text class="entry-title">复习</text>
                    <text class="entry-num">{{ dueCount }}</text>
                    <text class="entry-unit">个到期</text>
                    <text class="entry-action">开始复习</text>
                  </view>
                  <view class="entry entry-new pressable-soft" hover-class="press-soft" @click="goStudy('new')">
                    <text class="entry-kicker">NEW WORDS</text>
                    <text class="entry-title">学新词</text>
                    <text class="entry-num">{{ todayNewCount }}</text>
                    <text class="entry-unit">今日已学</text>
                    <text class="entry-action">继续学习</text>
                  </view>
                </view>

                <view class="overview" v-if="planName != ''">
                  <view class="section-heading">
                    <text class="section-title">学习进度</text>
                    <text class="overview-total">{{ learnedCount }} / {{ totalCount }}</text>
                  </view>
                  <view class="bar" v-if="totalCount > 0">
                    <view class="bar-ok" :style="'width:' + masterPct() + '%'"></view>
                    <view class="bar-learning" :style="'width:' + learningPct() + '%'"></view>
                    <view class="bar-rest"></view>
                  </view>
                  <view class="legend" v-if="totalCount > 0">
                    <view class="legend-item"><view class="dot dot-ok"></view><text class="legend-text">掌握 {{ masteredCount }}</text></view>
                    <view class="legend-item"><view class="dot dot-learning"></view><text class="legend-text">学习 {{ learningCount }}</text></view>
                    <view class="legend-item"><view class="dot dot-rest"></view><text class="legend-text">未学 {{ restCount() }}</text></view>
                  </view>
                  <view class="stats-row">
                    <view class="stat pressable-soft" hover-class="press-soft" @click="goStats('learning')">
                      <text class="stat-num num-blue">{{ learningCount }}</text><text class="stat-label">在学</text>
                    </view>
                    <view class="stat pressable-soft" hover-class="press-soft" @click="goStats('learned')">
                      <text class="stat-num num-green">{{ learnedCount }}</text><text class="stat-label">已学</text>
                    </view>
                    <view class="stat pressable-soft" hover-class="press-soft" @click="goStats('todayReview')">
                      <text class="stat-num num-red">{{ todayReviewCount }}</text><text class="stat-label">今日复习</text>
                    </view>
                    <view class="stat pressable-soft" hover-class="press-soft" @click="goStats('all')">
                      <text class="stat-num">{{ totalCount }}</text><text class="stat-label">总词数</text>
                    </view>
                  </view>
                </view>
                <view class="empty-plan pressable-soft" v-else hover-class="press-soft" @click="go('/pages/plan/list')">
                  <text class="section-title">从一份计划开始</text>
                  <text class="hero-note">还没有激活计划，点此选择或导入词单。</text>
                </view>
              </view>
            </scroll-view>
            <view class="sheet-footer">
              <text class="footer-note">ゆっくり、着実に。</text>
              <text class="footer-page">01 / 02</text>
            </view>
          </view>
        </view>
      </swiper-item>

      <swiper-item>
        <view class="sheet-shell">
          <view class="sheet">
            <image class="sheet-wash tools-wash" src="/static/aurora-bg.png" mode="aspectFill"></image>
            <scroll-view class="sheet-scroll" :scroll-y="true" :show-scrollbar="false">
              <view class="sheet-content">
                <view class="folio">
                  <text class="folio-label">NIHONGO / COLLECTION</text>
                  <text class="folio-date">CONTENTS</text>
                </view>
                <view class="hero tools-hero">
                  <text class="eyebrow">YOUR LEARNING SPACE</text>
                  <text class="hero-title">学习工具</text>
                  <text class="hero-note">整理词语，也整理自己的学习节奏。</text>
                </view>
                <view class="tool-list">
                  <view class="tool-row pressable-soft" hover-class="press-soft" @click="go('/pages/word/chain')">
                    <text class="tool-index tool-purple">01</text>
                    <view class="tool-copy"><text class="tool-title">链式记忆</text><text class="tool-desc">让孤单的词，在关联中留下来。</text></view>
                    <view class="tool-mark mark-purple"></view>
                  </view>
                  <view class="tool-row pressable-soft" hover-class="press-soft" @click="go('/pages/plan/list')">
                    <text class="tool-index tool-blue">02</text>
                    <view class="tool-copy"><text class="tool-title">学习计划</text><text class="tool-desc">选择词单，安排自己的进度。</text></view>
                    <view class="tool-mark mark-blue"></view>
                  </view>
                  <view class="tool-row pressable-soft" hover-class="press-soft" @click="go('/pages/library/library')">
                    <text class="tool-index tool-green">03</text>
                    <view class="tool-copy"><text class="tool-title">我的词库</text><text class="tool-desc">查找、编辑，积累每一个表达。</text></view>
                    <view class="tool-mark mark-green"></view>
                  </view>
                  <view class="tool-row pressable-soft" hover-class="press-soft" @click="go('/pages/settings/settings')">
                    <text class="tool-index tool-red">04</text>
                    <view class="tool-copy"><text class="tool-title">设置与备份</text><text class="tool-desc">调整复习周期，保存学习积累。</text></view>
                    <view class="tool-mark mark-red"></view>
                  </view>
                </view>
                <text class="tools-note">把每个词，放进自己的语境。</text>
              </view>
            </scroll-view>
            <view class="sheet-footer">
              <text class="footer-note">言葉を、つなぐ。</text>
              <text class="footer-page">02 / 02</text>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view class="pager">
      <view class="pager-tab pressable-soft" hover-class="press-soft" @click="selectPage(0)">
        <view class="pager-line" :class="currentPage == 0 ? 'pager-line-active' : ''"></view>
        <text class="pager-label" :class="currentPage == 0 ? 'pager-label-active' : ''">学习</text>
      </view>
      <text class="pager-hint">左右滑动</text>
      <view class="pager-tab pressable-soft" hover-class="press-soft" @click="selectPage(1)">
        <view class="pager-line" :class="currentPage == 1 ? 'pager-line-active' : ''"></view>
        <text class="pager-label" :class="currentPage == 1 ? 'pager-label-active' : ''">工具</text>
      </view>
    </view>
    <view :style="'height:' + safeBottom + 'px'"></view>
  </view>
</template>

<script setup lang="uts">
  import { buildTodaySummary } from '../../services/today.uts'
  import { awaitDatabase } from '../../repos/sqlite/bootstrap.uts'

  // 原生 swiper 负责横滑；可点击分页同时提供不依赖手势的入口。
  const currentPage = ref(0)
  const safeTop = ref(uni.getWindowInfo().statusBarHeight)
  const safeBottom = ref(uni.getWindowInfo().safeAreaInsets.bottom)

  const onPageChange = (event: UniSwiperChangeEvent) => {
    currentPage.value = event.detail.current
  }
  const selectPage = (index: number) => {
    currentPage.value = index
  }
  const updateSafeArea = () => {
    const info = uni.getWindowInfo()
    safeTop.value = info.statusBarHeight
    safeBottom.value = info.safeAreaInsets.bottom
  }
  onReady(() => { updateSafeArea() })
  onResize(() => { updateSafeArea() })

  const planName = ref('')
  const dueCount = ref(0)
  const learningCount = ref(0)
  const learnedCount = ref(0)
  const masteredCount = ref(0)
  const totalCount = ref(0)
  const todayNewCount = ref(0)
  const todayReviewCount = ref(0)

  // ---------- 展示辅助（模板只能调本地函数） ----------

  const WEEKS: Array<string> = ['日', '一', '二', '三', '四', '五', '六']

  const todayText = (): string => {
    const d = new Date()
    const week = WEEKS[d.getDay()]
    return (d.getMonth() + 1) + '月' + d.getDate() + '日 · 周' + week
  }

  const helloText = (): string => {
    const h = new Date().getHours()
    if (h < 6) {
      return '夜深了，注意休息'
    }
    if (h < 11) {
      return '早上好，开始今天的学习吧'
    }
    if (h < 14) {
      return '中午好，抽空背几个词'
    }
    if (h < 18) {
      return '下午好，继续加油'
    }
    return '晚上好，温故而知新'
  }

  const restCount = (): number => {
    const rest = totalCount.value - learnedCount.value
    return rest > 0 ? rest : 0
  }

  const masterPct = (): number => {
    if (totalCount.value == 0) {
      return 0
    }
    return masteredCount.value * 100 / totalCount.value
  }

  const learningPct = (): number => {
    if (totalCount.value == 0) {
      return 0
    }
    return learningCount.value * 100 / totalCount.value
  }

  // ---------- 数据 ----------

  const load = async () => {
    try {
      // 冷启动期先等数据库初始化完成（onLaunch 的 initDatabase 是异步的）
      const ok = await awaitDatabase()
      if (!ok) {
        return
      }
      const s = await buildTodaySummary()
      planName.value = s.planName
      dueCount.value = s.dueCount
      learningCount.value = s.learningCount
      learnedCount.value = s.learnedCount
      masteredCount.value = s.masteredCount
      totalCount.value = s.totalCount
      todayNewCount.value = s.todayNewCount
      todayReviewCount.value = s.todayReviewCount
    } catch (e) {
      console.error('今日任务加载失败', e)
    }
  }

  onLoad(() => {
    load()
  })

  // 从背词会话返回后刷新统计
  onShow(() => {
    load()
  })

  const goStudy = (mode: string) => {
    uni.navigateTo({ url: '/pages/study/study?mode=' + mode })
  }
  const go = (url: string) => {
    uni.navigateTo({ url: url })
  }
  // 统计条下钻：learning 在学 / learned 已学 / todayReview 今日复习 / all 计划全部
  const goStats = (type: string) => {
    uni.navigateTo({ url: '/pages/index/stats?type=' + type })
  }
</script>

<style lang="scss">
  @import '../../uni.scss';

  /* 每个横滑页面仅保留一张整页纸卡；内部用分区和色块，而非多层投影。 */
  .page { flex: 1; background-color: #eee8df; }
  .home-swiper { flex: 1; }
  .sheet-shell { height: 100%; padding: 18rpx 24rpx 10rpx; }
  .sheet {
    flex: 1;
    background-color: $a-surface;
    border: 1rpx solid rgba(37, 34, 43, 0.1);
    border-radius: 40rpx;
    overflow: hidden;
  }
  .sheet-wash { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.44; }
  .tools-wash { opacity: 0.3; transform: rotate(180deg); }
  .sheet-scroll { flex: 1; }
  .sheet-content { padding: 32rpx 34rpx 20rpx; }
  .folio { flex-direction: row; justify-content: space-between; align-items: center; }
  .folio-label, .folio-date { font-size: 18rpx; font-family: monospace; color: $n-text2; letter-spacing: 1rpx; }
  .hero { margin-top: 40rpx; margin-bottom: 36rpx; }
  .eyebrow { font-size: 20rpx; font-family: monospace; letter-spacing: 4rpx; color: $a-red-ink; }
  .hero-title { font-size: 52rpx; line-height: 70rpx; font-family: serif; font-weight: 500; color: $a-ink; margin-top: 14rpx; }
  .hero-note { font-size: 24rpx; line-height: 36rpx; color: $n-text2; margin-top: 12rpx; }
  .plan-line { margin-top: 30rpx; padding-left: 18rpx; border-left: 2rpx solid $a-red-ink; }
  .plan-label { font-size: 18rpx; color: $n-text2; letter-spacing: 2rpx; }
  .plan-name { font-size: 24rpx; line-height: 34rpx; color: $a-ink; margin-top: 6rpx; }
  .section-heading { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
  .section-title { font-size: 28rpx; font-family: serif; color: $a-ink; }
  .section-meta { font-size: 18rpx; font-family: monospace; letter-spacing: 1rpx; color: $n-text2; }
  .entries { flex-direction: row; }
  .entry { flex: 1; padding: 24rpx; border-radius: 24rpx; }
  .entry-review { background-color: #f3b7a0; }
  .entry-new { background-color: #f2dba3; margin-left: 18rpx; }
  .entry-kicker { font-size: 18rpx; font-family: monospace; letter-spacing: 2rpx; color: $a-ink; }
  .entry-title { font-size: 30rpx; font-family: serif; color: $a-ink; margin-top: 8rpx; }
  .entry-num { font-size: 84rpx; line-height: 100rpx; font-family: serif; color: $a-ink; margin-top: 20rpx; }
  .entry-unit { font-size: 22rpx; color: $a-ink; }
  .entry-action { font-size: 22rpx; color: $a-ink; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(37, 34, 43, 0.15); }
  .overview { margin-top: 28rpx; padding-top: 28rpx; border-top: 1rpx solid rgba(37, 34, 43, 0.15); }
  .overview-total { font-size: 22rpx; font-family: monospace; color: $n-text2; }
  .bar { flex-direction: row; height: 14rpx; border-radius: 10rpx; overflow: hidden; background-color: $n-cream; }
  .bar-ok { height: 14rpx; background-color: $n-green; }
  .bar-learning { height: 14rpx; background-color: $n-blue; }
  .bar-rest { flex: 1; height: 14rpx; background-color: $n-cream; }
  .legend { flex-direction: row; flex-wrap: wrap; margin-top: 16rpx; }
  .legend-item { flex-direction: row; align-items: center; margin-right: 20rpx; margin-bottom: 8rpx; }
  .dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; margin-right: 8rpx; }
  .dot-ok { background-color: $a-green-ink; }
  .dot-learning { background-color: $a-blue-ink; }
  .dot-rest { background-color: #b8afa2; }
  .legend-text { font-size: 21rpx; color: $n-text2; }
  .stats-row { flex-direction: row; margin-top: 12rpx; }
  .stat { flex: 1; align-items: center; justify-content: center; min-height: 92rpx; }
  .stat-num { font-size: 36rpx; font-family: serif; color: $a-ink; }
  .num-blue { color: $a-blue-ink; }
  .num-green { color: $a-green-ink; }
  .num-red { color: $a-red-ink; }
  .stat-label { font-size: 20rpx; color: $n-text2; margin-top: 8rpx; }
  .empty-plan { margin-top: 40rpx; padding: 28rpx 0; border-top: 1rpx solid $a-line; }
  .sheet-footer { flex-direction: row; justify-content: space-between; align-items: center; padding: 22rpx 34rpx 28rpx; }
  .footer-note { font-size: 20rpx; font-family: serif; color: $n-text2; letter-spacing: 2rpx; }
  .footer-page { font-size: 18rpx; font-family: monospace; color: $n-text2; letter-spacing: 2rpx; }
  .tools-hero { margin-top: 74rpx; margin-bottom: 58rpx; }
  .tool-list { border-top: 1rpx solid rgba(37, 34, 43, 0.2); }
  .tool-row { flex-direction: row; align-items: center; min-height: 104rpx; padding: 22rpx 0; border-bottom: 1rpx solid rgba(37, 34, 43, 0.15); }
  .tool-index { width: 58rpx; font-size: 22rpx; font-family: monospace; align-self: flex-start; margin-top: 6rpx; }
  .tool-copy { flex: 1; }
  .tool-title { font-size: 34rpx; font-family: serif; color: $a-ink; }
  .tool-desc { font-size: 22rpx; line-height: 32rpx; color: $n-text2; margin-top: 10rpx; }
  .tool-mark { width: 14rpx; height: 14rpx; border-radius: 7rpx; margin-left: 16rpx; }
  .tool-purple { color: $a-purple-ink; }
  .tool-blue { color: $a-blue-ink; }
  .tool-green { color: $a-green-ink; }
  .tool-red { color: $a-red-ink; }
  .mark-purple { background-color: $a-lilac; }
  .mark-blue { background-color: $a-sky; }
  .mark-green { background-color: $a-sage; }
  .mark-red { background-color: $a-peach; }
  .tools-note { font-size: 26rpx; font-family: serif; line-height: 38rpx; color: $n-text2; margin-top: 42rpx; }
  .pager { flex-direction: row; align-items: center; justify-content: center; height: 96rpx; }
  .pager-tab { min-width: 150rpx; height: 96rpx; align-items: center; justify-content: center; }
  .pager-line { width: 18rpx; height: 4rpx; border-radius: 2rpx; background-color: #c7beb4; margin-bottom: 10rpx; }
  .pager-line-active { width: 44rpx; background-color: $a-ink; }
  .pager-label { font-size: 22rpx; color: $n-text2; }
  .pager-label-active { color: $a-ink; font-weight: 600; }
  .pager-hint { font-size: 18rpx; color: $n-text2; letter-spacing: 2rpx; margin: 0 26rpx; }
</style>
