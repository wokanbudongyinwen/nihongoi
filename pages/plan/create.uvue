    padding: 24rpx;
    margin: 24rpx 28rpx 0;
  }
  .meta-row {
    flex-direction: row;
    align-items: center;
    padding: 12rpx 0;
  }
  .meta-label {
    width: 140rpx;
    font-size: 28rpx;
    color: $n-text2;
    font-family: monospace;
    letter-spacing: 1rpx;
  }
  .meta-input {
    flex: 1;
    background-color: $n-cream;
    border-width: 1rpx;
    border-style: solid;
    border-color: $a-line;
    border-radius: $n-r-sm;
    padding: 12rpx 20rpx;
    font-size: 28rpx;
  }
  .num {
    width: 160rpx;
  }
  .pr-hint {
    font-size: 22rpx;
    color: $n-text2;
    padding: 4rpx 0 8rpx;
  }
  .picked-bar {
    background-color: $n-cream;
    padding: 12rpx 24rpx;
    margin-top: 16rpx;
    border-bottom-width: 1rpx;
    border-bottom-style: solid;
    border-bottom-color: $a-line;
  }
  .picked-row {
    flex-direction: row;
    align-items: center;
  }
  .picked-chip {
    flex-direction: row;
    align-items: center;
    background-color: $n-card;
    border-width: 1rpx;
    border-style: solid;
    border-color: $a-line;
    border-radius: 999rpx;
    padding: 6rpx 18rpx;
    margin-right: 12rpx;
  }
  .picked-no {
    font-size: 20rpx;
    color: $n-text3;
    font-family: monospace;
    margin-right: 8rpx;
  }
  .picked-term {
    font-size: 24rpx;
    color: $n-ink;
  }
  .picked-x {
    font-size: 20rpx;
    color: $n-text3;
    margin-left: 10rpx;
  }
  .search-bar {
    padding: 24rpx;
    margin: 16rpx 28rpx 20rpx;
    background-color: rgba(255, 253, 249, 0.92);
  }
  .search-input {
    background-color: $n-cream;
    border-width: 1rpx;
    border-style: solid;
    border-color: $a-line;
    border-radius: $n-r-sm;
    padding: 18rpx 22rpx;
    font-size: 28rpx;
    color: $n-ink;
  }
  .count {
    font-size: 24rpx;
    color: $n-text2;
    font-family: monospace;
    letter-spacing: 2rpx;
    margin-top: 14rpx;
  }
  .list {
    flex: 1;
    padding: 0 28rpx;
  }
  .word-row {
    padding: 24rpx;
    margin: 0 4rpx 18rpx 0;
    flex-direction: row;
    align-items: center;
  }
  .row-on {
    background-color: $n-yellow;
    border-width: 0rpx;
  }
  .word-main {
    flex: 1;
  }
  .word-line {
    flex-direction: row;
    align-items: center;
  }
  .word-term {
    font-size: 32rpx;
    font-family: serif;
    font-weight: 500;
    color: $n-ink;
  }
  .word-reading {
    font-size: 24rpx;
    color: $a-blue-ink;
    font-weight: bold;
    margin-left: 16rpx;
  }
  .word-meaning {
    font-size: 26rpx;
    color: $n-text2;
    margin-top: 8rpx;
  }
  .pick-mark {
    font-size: 30rpx;
    color: $n-ink;
    font-weight: bold;
    margin-left: 16rpx;
  }
  .word-pos {
    font-size: 22rpx;
    color: $n-ink;
    background-color: $n-cream;
    border-width: 1rpx;
    border-style: solid;
    border-color: $a-line;
    border-radius: 999rpx;
    padding: 4rpx 12rpx;
    margin-left: 16rpx;
  }
  .cands-hint {
    padding: 60rpx 0;
    align-items: center;
  }
  .hint-text {
    font-size: 24rpx;
    color: $n-text3;
  }
  .bottom-space {
    height: 40rpx;
  }
  .footer {
    padding: 24rpx 28rpx;
  }
  .btn {
    background-color: $n-green;
    border-width: 0rpx;
    padding: 24rpx 0;
